# ---------------------------------------------------------------------------
# FilmStash Bot - environment variables
#
# 1. Copy this file to `.env`:
#        copy .env.example .env        (Windows cmd)
#        cp   .env.example .env        (bash / zsh)
# 2. Fill in the real values below.
# 3. NEVER commit the resulting `.env` file to version control.
# ---------------------------------------------------------------------------

# --- Telegram -----------------------------------------------------------------
# Token issued by @BotFather when you create your bot.
# Format: 123456789:AAExampleTokenStringGoesHere
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Supabase -----------------------------------------------------------------
# Project URL, found in Supabase Dashboard -> Project Settings -> API.
# Format: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# The SERVICE ROLE key - NOT the anon key.
#
# This must be the `service_role` key, found under "Project API keys" in
# Project Settings -> API. The `anon` key will NOT work: schema.sql enables Row
# Level Security with no permissive policies, so every read and write made with
# the anon key fails with:
#     42501: new row violates row-level security policy for table "movies"
#
# The service_role key bypasses RLS, which is what a trusted backend bot needs.
# It also bypasses ALL other security, so NEVER expose it in a browser or
# mobile client - server-side only.
#
# Verify which key you have:
#     python -c "import main; print(main._supabase_key_role())"
SUPABASE_KEY=your_supabase_service_role_key_here

# --- TMDB ---------------------------------------------------------------------
# API key (v3 auth) from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# --- Webhook / hosting (OPTIONAL) ---------------------------------------------
# Leave WEBHOOK_URL unset for local development: the bot then uses long polling,
# which needs no public URL. Set it in production (e.g. Render) to switch the
# bot to webhook mode automatically.
#
# WEBHOOK_URL is the public HTTPS base URL of your service, WITHOUT a trailing
# slash and WITHOUT the path. The bot appends WEBHOOK_PATH to it.
#   Render example: https://filmstash.onrender.com
# Telegram only accepts HTTPS, so an http:// value is rejected at startup.
# WEBHOOK_URL=https://filmstash.onrender.com

# Port the internal HTTP server binds to. Render injects PORT automatically and
# routes its public HTTPS traffic to it, so you normally do NOT set this
# yourself on Render. 10000 is Render's default and the fallback used here.
# PORT=10000

# Interface to bind. 0.0.0.0 is required on a host/container so the platform's
# router can reach the process. Only change this for local webhook testing.
# WEBHOOK_LISTEN=0.0.0.0

# URL path Telegram POSTs updates to. Must start with "/". Change it to
# something unguessable so random scanners cannot hit your endpoint.
# WEBHOOK_PATH=/telegram/webhook

# Optional shared secret. When set, Telegram sends it in the
# X-Telegram-Bot-Api-Secret-Token header and the bot rejects any request whose
# header does not match. Strongly recommended for a public endpoint.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# WEBHOOK_SECRET=your_random_secret_here
