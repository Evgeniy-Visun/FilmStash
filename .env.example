# ---------------------------------------------------------------------------
# FilmStash Bot - environment variables
#
# 1. Copy this file to `.env`:
#        copy .env.example .env        (Windows cmd)
#        cp   .env.example .env        (bash / zsh)
# 2. Fill in the real values below.
# 3. NEVER commit the resulting `.env` file to version control.
# ---------------------------------------------------------------------------

# --- Telegram -----------------------------------------------------------------
# Token issued by @BotFather when you create your bot.
# Format: 123456789:AAExampleTokenStringGoesHere
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Supabase -----------------------------------------------------------------
# Project URL, found in Supabase Dashboard -> Project Settings -> API.
# Format: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# The SERVICE ROLE key - NOT the anon key.
#
# This must be the `service_role` key, found under "Project API keys" in
# Project Settings -> API. The `anon` key will NOT work: schema.sql enables Row
# Level Security with no permissive policies, so every read and write made with
# the anon key fails with:
#     42501: new row violates row-level security policy for table "movies"
#
# The service_role key bypasses RLS, which is what a trusted backend bot needs.
# It also bypasses ALL other security, so NEVER expose it in a browser or
# mobile client - server-side only.
#
# Verify which key you have:
#     python -c "import main; print(main._supabase_key_role())"
SUPABASE_KEY=your_supabase_service_role_key_here

# --- TMDB ---------------------------------------------------------------------
# API key (v3 auth) from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
